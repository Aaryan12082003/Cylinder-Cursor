    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.6",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.5.0",
    "lucide-react": "^0.544.0",
    "motion-dom": "^14.5.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
