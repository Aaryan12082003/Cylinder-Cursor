    "@types/node": "^22.18.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^37.6.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "jsdom": "^26.1.0",
