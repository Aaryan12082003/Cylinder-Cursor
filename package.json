{
  "name": "cylinderflow",
  "productName": "CylinderFlow",
  "version": "1.0.2",
  "description": "Offline Windows desktop software for industrial gas cylinder inventory, dispatch, returns, and customer balances.",
  "author": "CylinderFlow",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Aaryan12082003/Cylinder-Cursor.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run rebuild:native && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run rebuild:native && npm run build && electron-builder --win --x64",
    "dist:linux": "npm run rebuild:native && npm run build && electron-builder --linux AppImage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icon.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
